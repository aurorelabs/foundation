<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(TelemetryVersion)</Version>
    <AssemblyName>Aurore.Foundation.Telemetry</AssemblyName>
    <RootNamespace>Aurore.Foundation.Telemetry</RootNamespace>
    <Product>Aurore Foundation @ Telemetry</Product>
    <Description>OpenTelemetry logs, metrics and traces over OTLP, with the personal data of spans encrypted.</Description>
    <PackageTags>aurore telemetry opentelemetry otlp tracing metrics logging</PackageTags>

    <!-- Required for OpenTelemetry packages that are on beta. NU5104 only fires for a stable version: when 1.0.0 leaves preview, replace or wait for the stable Instrumentation.Process. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.15.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Telemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
