<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(AspNetCoreVersion)</Version>
    <AssemblyName>Aurore.Foundation.AspNetCore</AssemblyName>
    <RootNamespace>Aurore.Foundation.AspNetCore</RootNamespace>
    <Product>Aurore Foundation @ AspNetCore</Product>
    <Description>ASP.NET Core building blocks: JWT and API key authentication, a request pipeline, minimal endpoints with versions, OpenAPI with Scalar, health checks and HTTP dependencies.</Description>
    <PackageTags>aurore aspnetcore minimal-api authentication openapi scalar health-checks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageReference Include="Scalar.AspNetCore.Microsoft" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Telemetry\Telemetry.csproj" />
  </ItemGroup>

</Project>
