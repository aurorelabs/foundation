<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(CoreVersion)</Version>
    <AssemblyName>Aurore.Foundation.Core</AssemblyName>
    <RootNamespace>Aurore.Foundation.Core</RootNamespace>
    <Product>Aurore Foundation @ Core</Product>
    <Description>Results and errors that map to HTTP, features with decorators, numbered and cursor pagination, entities, privacy of logs and the settings models shared by the Aurore packages.</Description>
    <PackageTags>aurore results errors features pagination validation privacy</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurore.Foundation.EntityFrameworkCore.Postgres" />
  </ItemGroup>

</Project>
