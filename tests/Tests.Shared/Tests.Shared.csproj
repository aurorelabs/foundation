<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stubs and helpers shared by the foundation test projects. It holds no tests itself. -->

  <PropertyGroup>
    <!-- It lives under tests/ but has no tests, so it is a plain library: the runner must not treat it as a test app, and it is never packed. -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
  </ItemGroup>

</Project>
